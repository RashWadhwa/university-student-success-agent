APP_NAME="University Student Success Agent"
APP_VERSION="0.4.0"
ENVIRONMENT="development"
DEBUG=true
DOCS_ENABLED=true
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS='["http://localhost:3000","http://localhost:8501"]'

# Use mock for key-free local setup. Change to openai when your key is ready.
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_ORG_ID=""
OPENAI_PROJECT_ID=""
OPENAI_BASE_URL=""
LLM_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1200
ENABLE_LLM_SMOKE_TEST=true

# Stage 3 document ingestion
DOCUMENT_STORAGE_PATH="data/documents"
MAX_DOCUMENT_SIZE_BYTES=10485760
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Stage 4 PostgreSQL + pgvector (replace only DATABASE_URL for Supabase)
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://student_success:student_success@localhost:5432/student_success"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_READINESS_TIMEOUT=3
EMBEDDING_BATCH_SIZE=32
# text-embedding-3-small defaults to 1536 dimensions; keep this aligned with the provider.
EMBEDDING_DIMENSIONS=1536
