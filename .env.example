APP_NAME="University Student Success Agent"
APP_VERSION="0.7.0"
ENVIRONMENT="development"
DEBUG=true
DOCS_ENABLED=true
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS='["http://localhost:3000","http://localhost:8501"]'

# Configurable institution and its small, curated public-policy corpus
PRIMARY_INSTITUTION_NAME="Harper Adams University"
PRIMARY_INSTITUTION_CORPUS_MANIFEST="data/institutions/primary-corpus.json"
PRIMARY_INSTITUTION_SOURCE_HOSTS='["www.harper-adams.ac.uk","cdn.harper-adams.ac.uk"]'
CORPUS_DOWNLOAD_TIMEOUT_SECONDS=30

# Use mock for key-free local setup. Change to openai when your key is ready.
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_ORG_ID=""
OPENAI_PROJECT_ID=""
OPENAI_BASE_URL=""
LLM_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1200
ENABLE_LLM_SMOKE_TEST=true

# Stage 7 independent LLM-as-judge evaluation
EVAL_PROVIDER=gemini
EVAL_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=your_key_here
EVAL_MAX_CASES_PER_RUN=50
EVAL_MAX_JUDGE_CALLS=100
EVAL_TIMEOUT_SECONDS=30
EVALUATION_DATASET_PATH="data/evaluation/stage7-policy-cases.jsonl"

# Stage 7 Langfuse Cloud EU observability (real keys belong in .env only)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_EVENT_TIMEOUT_SECONDS=0.5

# Used by Streamlit only; it never receives provider, database, or Langfuse secrets.
FASTAPI_BASE_URL=http://localhost:8000
FRONTEND_REQUEST_TIMEOUT_SECONDS=30
FRONTEND_MAX_UPLOAD_BYTES=10485760

# Stage 3 document ingestion
DOCUMENT_STORAGE_PATH="data/documents"
MAX_DOCUMENT_SIZE_BYTES=10485760
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Stage 4 PostgreSQL + pgvector (replace only DATABASE_URL for Supabase)
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://student_success:student_success@localhost:5432/student_success"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_READINESS_TIMEOUT=3
EMBEDDING_BATCH_SIZE=32
# text-embedding-3-small defaults to 1536 dimensions; keep this aligned with the provider.
EMBEDDING_DIMENSIONS=1536

# Stage 5 grounded ask workflow
ASK_DEFAULT_TOP_K=5
ASK_MAX_TOP_K=10
ASK_MIN_EVIDENCE_COUNT=1
ASK_MIN_RETRIEVAL_SCORE=0.5
ASK_MAX_EVIDENCE_CHUNKS=5
ASK_EVIDENCE_MAX_CHARS_PER_CHUNK=2000
ASK_MAX_QUESTION_CHARS=2000
CITATION_EXCERPT_MAX_CHARS=400

# Stage 6 controlled multi-agent orchestration
AGENT_MAX_TASKS=4
AGENT_MAX_TOOL_CALLS=4
AGENT_TIMEOUT_SECONDS=20
AGENT_MAX_RETRIES=1
AGENT_MAX_EVIDENCE_ITEMS=5
AGENT_MAX_PROVIDER_CALLS=5
